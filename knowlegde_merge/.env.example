# 复制成 .env 后填写；抽取与写作都走这个端点：不填 key 跑不了 build 和 ask
# 任意 OpenAI 兼容端点都行：DeepSeek / Ollama / vLLM / OpenCode 网关

NEWSKG_LLM_BASE_URL=https://api.deepseek.com/v1
NEWSKG_LLM_API_KEY=
NEWSKG_LLM_MODEL=deepseek-chat

# KGGen 专用（可选）：不设时沿用上面的 NEWSKG_LLM_*，适合只有一个 key 的场景
# NEWSKG_KGGEN_MODEL=openai/gpt-4o-mini
# NEWSKG_KGGEN_BASE_URL=
# 单篇输出上限；调小会让长文 JSON 被截断，整篇记 0 条
NEWSKG_KGGEN_MAX_TOKENS=8192

# 科技相关性打分用的模型（与上面的抽取 LLM 相互独立：筛选用小模型，抽取用强模型）
# 一个都不设时整体沿用 NEWSKG_LLM_*，适合只有一个 key 的场景。
# 配了任意一个 NEWSKG_TOPIC_* 就完全独立，MODEL 缺省为 qwen3.8-flash。
# 任意 OpenAI 兼容端点均可；下面这组是阿里 token-plan 网关的实测配置。
# NEWSKG_TOPIC_BASE_URL=https://token-plan.maas.qianwenaiapi.com/compatible-mode/v1
# NEWSKG_TOPIC_API_KEY=
# NEWSKG_TOPIC_MODEL=qwen3.8-flash
# 阈值：0-10，低于此分丢弃。6 ≈「科技是主线之一」，7-8 更严，5 更宽。
NEWSKG_TOPIC_THRESHOLD=6
NEWSKG_TOPIC_BATCH=20
NEWSKG_TOPIC_CACHE=out/topic_scores.json

# Guardian Open Platform 免费 key（非商业用途）
GUARDIAN_API_KEY=

# 覆盖默认 RSS 订阅（逗号分隔）
NEWSKG_RSS_FEEDS=

# 覆盖默认科技源集合（逗号分隔的注册名，见 src/newskg/sources/tech.py 的 FEEDS）
NEWSKG_TECH_FEEDS=

# 调参
NEWSKG_MAX_ARTICLES=30
NEWSKG_POLITE_DELAY=1.0
NEWSKG_DEDUP_HAMMING=6
NEWSKG_DEDUP_JACCARD=0.55
