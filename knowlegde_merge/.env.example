# 复制成 .env 后填写；不填也能跑 demo（规则后端 + 离线样例）
# 任意 OpenAI 兼容端点都行：DeepSeek / Ollama / vLLM / OpenCode 网关

NEWSKG_LLM_BASE_URL=https://api.deepseek.com/v1
NEWSKG_LLM_API_KEY=
NEWSKG_LLM_MODEL=deepseek-chat

# Guardian Open Platform 免费 key（非商业用途）
GUARDIAN_API_KEY=

# 覆盖默认 RSS 订阅（逗号分隔）
NEWSKG_RSS_FEEDS=

# 调参
NEWSKG_MAX_ARTICLES=30
NEWSKG_POLITE_DELAY=1.0
NEWSKG_DEDUP_HAMMING=6
NEWSKG_DEDUP_JACCARD=0.55